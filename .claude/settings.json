{
  "// note": "Merge this into .claude/settings.json at the repo root. Make every script executable: chmod +x .claude/hooks/*.sh",

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-sensitive-paths.sh" }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-tests-after-edit-gradle.sh",
            "async": true,
            "timeout": 300
          }
        ]
      }
    ],

    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-stop-without-tests.sh" }
        ]
      }
    ]
  }
}
