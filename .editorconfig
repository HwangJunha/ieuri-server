root = true

[*.{kt,kts}]
# 스타일 센서(ktlint) 규칙 — SPEC-0039 D-21
ktlint_code_style = intellij_idea
# 헥사고날 레이아웃의 `port.in`·`adapter.in` 패키지(백틱 `in`)와 충돌하는 규칙이라 끈다
ktlint_standard_package-name = disabled
# ktlint 1.7부터 기본 꺼짐 — 쓰지 않는 import가 패키지 간 의존을 잘못 보이게 해서 켠다(SPEC-0039 D-97)
ktlint_standard_no-unused-imports = enabled
