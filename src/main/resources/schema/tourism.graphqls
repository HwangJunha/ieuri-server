# ============================================================
# SPEC-0002 — 관광지 스와이프 추천 (tourism 도메인)
# additive only. 기존 타입/필드/enum을 변경하지 않는다. BREAKING 없음.
# 재사용(auth.graphqls): interface BaseResponse, type UserError, type PageInfo.
# 루트 Query/Mutation은 auth.graphqls가 이미 선언하므로 여기선 extend 한다.
# ============================================================

extend type Query {
    "위치 기반 관광지 목록. TourAPI locationBasedList2를 실시간 호출하며 DB에 저장하지 않는다."
    # TourAPI는 pageNo 오프셋 페이지네이션만 지원한다. 라이브 데이터라 커서 안정성을 보장할 수 없어
    # 오프셋(page/size)으로 서빙한다. 클라이언트는 한 페이지(기본 100건)를 받아 스택에 쌓고, 소진 시 page+1을 조회한다.
    spots(
        latitude: Float!
        longitude: Float!
        "조회 반경(미터). 기본 20000, 서버 UX/성능 상한 100000(초과 시 RADIUS_TOO_LARGE)."
        radiusMeters: Int = 20000
        "언어 중립 카테고리. 현재 언어에서 유효한 값만 availableSpotCategories로 확인."
        category: SpotCategory
        "페이지 번호(1-base). 기본 1."
        page: Int = 1
        "페이지 크기. 기본 100, 서버 상한 100(초과 시 클램프)."
        size: Int = 100
    ): SpotPage!

    "현재 언어(Accept-Language)에서 유효한 관광지 카테고리 목록. 여행코스(KO 전용)·교통(외국어 전용) 비대칭을 흡수한다."
    availableSpotCategories: [SpotCategory!]!
}

extend type Mutation {
    "관광지 좋아요/싫어요 기록. 동일 장소라도 언어별 contentId가 다르므로 서버가 (contentId, 요청언어)로 저장한다. 재평가는 덮어쓴다(취소는 범위 밖)."
    reactToSpot(input: ReactToSpotInput!): ReactToSpotPayload!
}

"지원 언어. 문서·향후 explicit override용. spots/availableSpotCategories는 locale 인자를 받지 않으며 언어는 Accept-Language에서 온다(부재 시 EN 폴백)."
enum Locale {
    EN
    KO
    JA
    ZH
}

"언어 중립 관광지 카테고리. 서버가 언어별 TourAPI content-type 코드로 매핑한다. 모든 언어에서 모든 값이 유효하지는 않다 — availableSpotCategories 참조."
enum SpotCategory {
    TOURIST_SPOT
    CULTURAL_FACILITY
    FESTIVAL_EVENT
    "한국어(KO) 서비스에서만 제공됨."
    TRAVEL_COURSE
    LEISURE_SPORTS
    LODGING
    SHOPPING
    RESTAURANT
    "외국어(EN/JA/ZH) 서비스에서만 제공됨."
    TRANSPORT
}

"TourAPI cpyrhtDivCd 매핑. 클라이언트가 유형별로 렌더링을 분기하므로 서버가 감추거나 기본값으로 뭉개지 않는다."
enum CopyrightType {
    "공공누리 제1유형 — 출처표시. 상업·변형 가능."
    TYPE1
    "공공누리 제3유형 — 출처표시 + 변경금지."
    TYPE3
    "TourAPI가 값을 제공하지 않음. 보수적으로 변경금지에 준해 취급."
    UNSPECIFIED
}

enum SpotReaction {
    LIKE
    DISLIKE
}

"locationBasedList2가 요청 언어로 반환한 물리적 장소 1건. 상세/overview/다중이미지는 이번 스펙 범위 밖."
type Spot {
    "TourAPI contentId. 주의: 같은 장소라도 언어별로 다르다 — 요청 언어 내에서만 안정적."
    id: ID!
    title: String!
    "주소. addr1/addr2 병합(카드엔 상세 구분 불필요). 값이 없을 수 있음."
    address: String
    "https 정규화된 카드 이미지(firstimage). Non-null: 상위 조회가 이미지 보유 항목만 반환하도록 보장(운영 방침)."
    thumbnailImageUrl: String!
    "Haversine 직선거리(미터). 서버가 요청 좌표 기준 계산."
    distanceMeters: Float!
    category: SpotCategory!
    copyright: CopyrightType!
    "공공누리 출처표시 문구(사람이 읽는 텍스트). UNSPECIFIED여도 최소 출처를 담는다."
    attributionText: String!
    "TourAPI mapx/mapy(경도/위도, 원 좌표계)."
    mapX: Float!
    mapY: Float!
}

"관광지 오프셋 페이지. items는 거리 오름차순(가까운 곳 우선, POL-019) 정렬. 소진 판정은 hasNext로."
type SpotPage {
    items: [Spot!]!
    "현재 페이지 번호(1-base)."
    page: Int!
    "다음 페이지 존재 여부. false면 마지막 페이지 — 클라이언트는 빈 상태로 전환."
    hasNext: Boolean!
    "TourAPI totalCount(비관광·이미지 필터 이전 총계). 실제 전달 건수보다 큼 — 참고용."
    totalCount: Int
}

"language는 인자로 받지 않는다 — 서버가 요청 언어(Accept-Language)와 결합해 저장."
input ReactToSpotInput {
    "반응이 기록되는 언어별 contentId."
    spotId: ID!
    reaction: SpotReaction!
}

type ReactToSpotPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}
