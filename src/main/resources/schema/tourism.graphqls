extend type Query {
    "단건 상세 조회. id는 **언어와 무관한 장소 식별자**로 Spot.id를 그대로 넘긴다 — 언어를 바꿔도 같은 id로 조회된다. 본문 언어는 Accept-Language로 전달하며 locale 인자는 없다. 해소 불가한 id는 최상위 오류(SPOT_NOT_FOUND)다."
    spotDetail(id: ID!): SpotDetail!

    "위치 기반 관광지 목록. 오프셋 페이지네이션(page/size)이며 커서가 아니다."
    spots(
        latitude: Float!
        longitude: Float!
        "검색 반경(미터). 기본 20000, 최대 100000 — 초과 시 RADIUS_TOO_LARGE."
        radiusMeters: Int = 20000
        "언어 중립 카테고리 필터. availableSpotCategories에 있는 값만 유효하다."
        category: SpotCategory
        "페이지 번호, 1부터."
        page: Int = 1
        "페이지 크기. 기본 100, 상한 100 — 초과 시 클램프된다."
        size: Int = 100
    ): SpotPage!

    "현재 언어(Accept-Language)에서 유효한 카테고리 목록. 언어별로 다르다."
    availableSpotCategories: [SpotCategory!]!

    "내가 좋아요한 장소 목록. 요청 언어 한정, 최신순. 인증 필수(UNAUTHENTICATED)."
    likedSpots(
        "카테고리 필터. 생략하면 전체."
        category: SpotCategory
        first: Int = 20
        after: String
    ): LikedSpotConnection!

    """
    반경 내 spot을 제목·주소 대상 BM25 관련도 순으로 검색한다.

    정렬은 계약이다: BM25 관련도를 거리로 가중한 순서이며, 동점일 때 spot id 오름차순으로
    확정된다.

    **오프셋 페이지네이션이다**(page/size). 다른 신규 커넥션과 달리 커서를 쓰지 않는데,
    관련도 점수는 검색 엔진이 계산하는 값이라 커서에 담아 "이 점수보다 뒤"를 조건으로 걸 수
    없기 때문이다. 페이지를 넘기는 사이 코퍼스가 바뀌면 경계에서 항목이 밀릴 수 있으나,
    spot은 일 1회 배치로만 바뀌어 실질적으로 안정적이다.

    결과 0건은 정상이며 오류가 아니다. 질의가 공백뿐이거나 100자를 초과하면 userErrors로
    거절되고 connection은 비어 있다.
    """
    searchSpots(
        "검색어. 트림 후 비어 있으면 EMPTY_QUERY, 100자를 초과하면 QUERY_TOO_LONG."
        query: String!
        latitude: Float!
        longitude: Float!
        "검색 반경(미터). 기본 20000, 최대 100000 — 초과 시 RADIUS_TOO_LARGE."
        radiusMeters: Int = 20000
        "언어 중립 카테고리 필터. 생략하면 전체."
        category: SpotCategory
        "페이지 번호, 1부터. 최대 500 — 초과 시 PAGE_TOO_DEEP."
        page: Int = 1
        "페이지 크기. 기본 20, 상한 50 — 초과 시 클램프된다."
        size: Int = 20
    ): SpotSearchPayload!

    """
    반경 내 spot 제목에 대한 접두 자동완성.

    페이지네이션하지 않는다 — 지연에 민감한 입력 보조 수단이다.
    빈 질의는 오류가 아니라 빈 목록을 반환한다.
    """
    spotSearchSuggestions(
        "접두사. 트림 후 비어 있으면 빈 목록이다(오류 아님)."
        query: String!
        latitude: Float!
        longitude: Float!
        "검색 반경(미터). 기본 20000, 최대 100000 — 초과 시 RADIUS_TOO_LARGE."
        radiusMeters: Int = 20000
        "기본 10, 상한 10 — 초과 시 클램프된다."
        limit: Int = 10
    ): [SpotSuggestion!]!

    """
    반경 내에서 오늘이 행사 기간에 포함된 축제만 반환한다.

    경계를 포함한다 — 오늘이 시작일 또는 종료일과 같아도 진행 중이다.
    '오늘'의 기준은 서버 시각이다. 거리 오름차순, 동점 시 id 오름차순으로 정렬된다.

    반경 내 진행 중 축제가 0건인 것은 흔한 정상 상태다 — 오류가 아니다.
    """
    ongoingFestivals(
        latitude: Float!
        longitude: Float!
        "검색 반경(미터). 기본 20000, 최대 100000 — 초과 시 RADIUS_TOO_LARGE."
        radiusMeters: Int = 20000
        "기본 20, 상한 50 — 초과 시 클램프된다."
        first: Int = 20
        after: String
    ): FestivalConnection!

    """
    반경 내 spot을 누적 좋아요 수 내림차순으로 반환한다. 기간 제한 없이 전체를 집계한다.

    좋아요가 10개 미만인 spot은 제외한다 — 표본이 적으면 순위가 사실상 잡음이다.
    동점일 때 spot id 오름차순으로 확정된다.

    조건을 만족하는 spot이 0건인 것은 정상 상태다 — 오류가 아니다.
    """
    popularSpots(
        latitude: Float!
        longitude: Float!
        "검색 반경(미터). 기본 20000, 최대 100000 — 초과 시 RADIUS_TOO_LARGE."
        radiusMeters: Int = 20000
        "언어 중립 카테고리 필터. 생략하면 전체."
        category: SpotCategory
        "기본 20, 상한 50 — 초과 시 클램프된다."
        first: Int = 20
        after: String
    ): PopularSpotConnection!
}

extend type Mutation {
    "관광지 좋아요/싫어요 기록. 다시 반응하면 덮어쓰며, 반응 취소 수단은 없다."
    reactToSpot(input: ReactToSpotInput!): ReactToSpotPayload!
}

"지원 언어. 활성 언어는 Accept-Language에서 오며(부재 시 EN) 인자로 받지 않는다."
enum Locale {
    EN
    KO
    JA
    ZH
}

"언어 중립 관광지 카테고리. 모든 언어에서 모든 값이 유효하지는 않다 — availableSpotCategories 참조."
enum SpotCategory {
    TOURIST_SPOT
    CULTURAL_FACILITY
    FESTIVAL_EVENT
    "한국어(KO) 서비스 전용."
    TRAVEL_COURSE
    LEISURE_SPORTS
    LODGING
    SHOPPING
    RESTAURANT
    "외국어(EN/JA/ZH) 서비스 전용."
    TRANSPORT
}

"저작권 유형. 클라이언트가 유형별로 출처 표기를 분기한다."
enum CopyrightType {
    "공공누리 제1유형"
    TYPE1
    "공공누리 제3유형"
    TYPE3
    "저작권 유형을 확인할 수 없음. 출처 표기는 TYPE3에 준해 처리한다."
    UNSPECIFIED
}

enum SpotReaction {
    LIKE
    DISLIKE
}

"요청 언어로 반환된 물리적 장소 1건."
type Spot {
    "안정적 식별자. **언어와 무관하다** — 언어를 바꿔도 같은 장소는 같은 id다. spotDetail(id:)·posts(catalogId:)·createPost(catalogId:)·reactToSpot(catalogId:)에 그대로 넘긴다."
    id: ID!
    title: String!
    "주소. 없을 수 있다."
    address: String
    "카드 이미지 URL(https). 이미지가 없는 항목은 결과에서 제외되므로 항상 존재한다."
    thumbnailImageUrl: String!
    "요청 좌표로부터의 직선거리(미터)."
    distanceMeters: Float!
    category: SpotCategory!
    copyright: CopyrightType!
    "출처 표기 문구. UNSPECIFIED여도 채워진다."
    attributionText: String!
    "경도."
    mapX: Float!
    "위도."
    mapY: Float!
}

"관광지 오프셋 페이지. 거리 오름차순(가까운 곳 우선) 정렬이며 hasNext로 소진을 판정한다."
type SpotPage {
    items: [Spot!]!
    "현재 페이지 번호, 1부터."
    page: Int!
    "다음 페이지 존재 여부. false면 마지막 페이지다."
    hasNext: Boolean!
    "필터 이전 총계라 실제 전달 건수보다 클 수 있다. 참고용."
    totalCount: Int
}

"language 인자를 받지 않는다 — 현재 요청 언어 기준으로 기록된다."
input ReactToSpotInput {
    "대상 장소의 id(Spot.id와 같은 값). **언어와 무관하다** — 어느 언어에서 누르든 같은 기록에 모인다."
    catalogId: ID!
    reaction: SpotReaction!
}

type ReactToSpotPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}

"갤러리 이미지 1장. 저작권과 출처 표기는 이미지별이며 부모 Spot에서 상속하지 않는다."
type SpotImage {
    "원본 이미지 URL(https). url이 없는 항목은 제외되므로 항상 존재한다."
    imageUrl: String!
    "축소본 URL. 없을 수 있다."
    thumbnailUrl: String
    "이미지 설명. 없는 경우가 잦다."
    caption: String
    "이미지별 저작권 유형."
    copyright: CopyrightType!
    "저작권 유형에 대응하는 표준 출처 표기 문구."
    attributionText: String!
}

"관광지 상세. 언어와 무관한 장소 식별자를 키로 한다."
type SpotDetail {
    "Spot.id와 같은 값. 언어를 바꿔도 변하지 않는다."
    id: ID!
    title: String!
    category: SpotCategory!
    "대표 이미지 URL(https)."
    thumbnailImageUrl: String!
    "장문 소개. 없을 수 있으며, 빈 문자열은 null로 정규화된다."
    overview: String
    "주소. 없을 수 있다."
    address: String
    "홈페이지 URL. 없는 경우가 잦다."
    homepage: String
    "대표 전화번호. 없는 경우가 잦다."
    tel: String
    "저작권 유형."
    copyright: CopyrightType!
    "저작권 유형에서 파생된 출처 표기 문구."
    attributionText: String!

    """
    최대 10장, 서버가 준 순서. 원소는 non-null이다.

    null은 이 필드의 조회가 실패했다는 뜻이며, 본문은 정상 반환되고 실패는 최상위 errors[]에
    path로 표면화된다. 빈 배열은 이미지가 실제로 없다는 뜻이다.
    두 경우를 구분하는 별도 필드는 없으며, 클라이언트는 둘을 동일하게(썸네일 1장 폴백) 처리한다.
    """
    gallery: [SpotImage!]

    "이 장소의 LIKE 수. non-null이며 없으면 0이다."
    likeCount: Int!

    """
    운영 정보(이용시간·휴무일·주차 등). 이 장소의 category 값을 그대로 넘긴다.
    해당 카테고리·언어에 보여줄 값이 없으면 null이다.
    """
    intro(category: SpotCategory!): SpotIntro

    """
    이용안내 반복 항목. category는 intro와 같은 의미다.

    null은 이 필드의 조회 실패(최상위 errors[]에 표면화), 빈 배열은 항목이 없다는 뜻이다.
    """
    infoItems(category: SpotCategory!): [SpotInfoItem!]
}

"운영 정보. 카테고리마다 다른 응답을 공통 필드명으로 정규화한다. 해당 개념이 없는 카테고리에서는 null이다."
type SpotIntro {
    "영업·이용 시간."
    businessHours: String
    "휴무일."
    closedDays: String
    "주차 정보."
    parking: String
    "문의·안내 연락처. SpotDetail.tel과 다를 수 있다."
    inquiryPhone: String
    "이용요금·입장료. 음식점은 null이며 메뉴 가격이 아니다."
    fee: String
    "반려동물 동반 안내."
    petAllowed: String
    "신용카드 가능 여부."
    creditCardAccepted: String
}

"이용안내 항목 1건."
type SpotInfoItem {
    "항목명."
    name: String!
    "항목 내용. HTML 태그가 섞일 수 있어 클라이언트가 정제한다."
    text: String!
}

"목록 카드와 상세 진입에 필요한 값만 담는다. 거리와 좌표는 제공하지 않는다."
type LikedSpot {
    "장소 식별자. 언어와 무관하며 spotDetail(id:)에 그대로 넘긴다."
    id: ID!
    title: String!
    thumbnailImageUrl: String!
    address: String
    category: SpotCategory!
    copyright: CopyrightType!
    "저작권 유형에서 파생된 출처 표기 문구."
    attributionText: String!
}

"좋아요 목록 커서 연결. 총 개수는 제공하지 않으며 pageInfo.hasNextPage로 소진을 판정한다."
type LikedSpotConnection {
    edges: [LikedSpotEdge!]!
    pageInfo: PageInfo!
}

type LikedSpotEdge {
    cursor: String!
    node: LikedSpot!
    "좋아요한 시각(ISO-8601). 이 값 기준 최신순 정렬이다."
    likedAt: String!
}

"""
검색 결과 payload. 입력 검증 실패를 최상위 errors[]가 아니라 데이터로 돌려주기 위한 형태다.

connection은 검증에 실패해도 항상 존재하며 그때는 비어 있다 — 클라이언트가 null 분기 없이
읽을 수 있게 하기 위함이다.
"""
type SpotSearchPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    connection: SpotSearchConnection!
}

"""
검색 결과 오프셋 페이지. 관련도(거리 가중) 내림차순, 동점 시 id 오름차순이다.

커서가 아닌 이유는 searchSpots 설명 참조 — 관련도는 엔진이 계산하는 값이라 커서 조건으로
표현할 수 없다.
"""
type SpotSearchConnection {
    items: [Spot!]!
    "현재 페이지 번호, 1부터."
    page: Int!
    "다음 페이지 존재 여부. false면 마지막 페이지다."
    hasNext: Boolean!
    "반경·카테고리·질의를 모두 적용한 뒤의 전체 건수. 검색 페이지가 이 값을 표시한다."
    totalCount: Int!
}

"""
자동완성 항목. 제안 목록에 필요한 최소 형태이며 거리·주소를 담지 않는다 — 선택하면 검색이나
상세 조회로 이어지므로 그 시점에 온전한 정보를 받는다.
"""
type SpotSuggestion {
    "장소 식별자. 언어와 무관하며 spotDetail(id:)에 그대로 넘긴다."
    id: ID!
    title: String!
    category: SpotCategory!
}

"""
진행 중인 축제. Spot과 같은 식별·위치 필드에 행사 기간을 더한 형태다.

Spot을 재사용하지 않는 이유: eventStartDate/eventEndDate는 축제 행에만 존재하므로 범용 Spot에
두면 대부분의 spot에서 영구히 null인 필드가 된다.
"""
type Festival {
    "장소 식별자. 언어와 무관하며 spotDetail(id:)에 그대로 넘긴다."
    id: ID!
    title: String!
    "주소. 없을 수 있다."
    address: String
    "카드 이미지 URL(https)."
    thumbnailImageUrl: String!
    "요청 좌표로부터의 직선거리(미터)."
    distanceMeters: Float!
    category: SpotCategory!
    copyright: CopyrightType!
    "출처 표기 문구. UNSPECIFIED여도 채워진다."
    attributionText: String!
    "경도."
    mapX: Float!
    "위도."
    mapY: Float!
    "행사 시작일. ISO-8601 날짜(YYYY-MM-DD)이며 시각 성분이 없다 — 원본이 DATE 컬럼이다."
    eventStartDate: String!
    "행사 종료일. 형식은 eventStartDate와 같고, 이 날짜까지 진행 중으로 본다."
    eventEndDate: String!
}

"""
진행 중 축제 커서 연결. 거리 오름차순 정렬이다.

총 개수는 제공하지 않는다 — 소진 판정은 pageInfo.hasNextPage로 한다(likedSpots와 같은 규약).
"""
type FestivalConnection {
    edges: [FestivalEdge!]!
    pageInfo: PageInfo!
}

type FestivalEdge {
    node: Festival!
    "거리와 spot id를 인코딩한 불투명 커서."
    cursor: String!
}

"""
인기 spot 커서 연결. 좋아요 수 내림차순 정렬이다.

총 개수는 제공하지 않는다 — 소진 판정은 pageInfo.hasNextPage로 한다(likedSpots와 같은 규약).
"""
type PopularSpotConnection {
    edges: [PopularSpotEdge!]!
    pageInfo: PageInfo!
}

type PopularSpotEdge {
    node: Spot!
    "좋아요 수와 spot id를 인코딩한 불투명 커서."
    cursor: String!
    "순위 근거인 누적 좋아요 수. 순위와 무관한 다른 조회에서는 의미가 없어 Spot에 두지 않는다."
    likeCount: Int!
}
