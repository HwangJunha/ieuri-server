extend type Query {
    """
    피드. 세로 전면 스크롤 목록이다.
    최신순 고정이며 정렬 인자를 받지 않는다. 기본 20, 상한 50이고 초과분은 오류가 아니라 절삭된다.
    차단 관계(양방향) 작성자의 항목은 제외된다.
    """
    feed(first: Int = 20, after: String): FeedConnection!

    "피드 단건. 삭제되었거나 차단 관계의 작성자면 오류가 아니라 null이다(post(id:)와 같은 관례)."
    feedItem(id: ID!): FeedItem

    "내가 참여한 대화 목록. 최근 활동순. 기본 20, 상한 50이며 초과분은 절삭된다."
    conversations(first: Int = 20, after: String): ConversationConnection!

    """
    대화의 메시지. 최신순으로 페이징한다 — 채팅 화면은 위로 올릴수록 과거를 더 불러온다.
    기본 30, 상한 50이며 초과분은 절삭된다.
    참여자가 아니거나 없는 대화면 최상위 errors[]의 FORBIDDEN이다 — 조회는 볼 자격 자체가 없어
    부분 성공이 성립하지 않는다.
    """
    conversationMessages(conversationId: ID!, first: Int = 30, after: String): MessageConnection!
}

extend type Mutation {
    """
    피드 작성. catalogId 필수, photoKeys 1~5개 필수다.
    photoKeys는 confirmPostImageUploads가 확정한 키를 그대로 쓴다.
    이미 다른 피드에 실린 키는 PHOTO_NOT_CONFIRMED로 거부된다.
    """
    createFeedItem(input: CreateFeedItemInput!): CreateFeedItemPayload!

    "피드 좋아요. 멱등이다 — 이미 좋아요한 피드에 다시 눌러도 수가 늘지 않는다."
    likeFeedItem(input: LikeFeedItemInput!): LikeFeedItemPayload!

    "피드 좋아요 취소. 멱등이며 좋아요 수가 음수가 되지 않는다."
    unlikeFeedItem(input: UnlikeFeedItemInput!): UnlikeFeedItemPayload!

    """
    피드 작성자와의 1:1 대화를 시작한다. 입력이 회원 id가 아니라 feedItemId이므로
    커뮤니티 글 작성자는 대화 상대가 될 수 없다.
    같은 상대와 대화가 이미 있으면 새로 만들지 않고 기존 대화를 반환한다.
    첫 메시지 전송은 별개 호출이라 빈 대화가 존재할 수 있다.
    """
    startConversation(input: StartConversationInput!): StartConversationPayload!

    """
    메시지 전송. 텍스트·피드 인용·사진을 함께 또는 각각 보낼 수 있으며 셋 다 비면 거부된다.
    대화 성립 이후에 생긴 차단도 여기서 다시 판정되어 거부된다.
    """
    sendMessage(input: SendMessageInput!): SendMessagePayload!

    """
    타이핑 상태 알림. 영속화하지 않으며 전달 보장이 없다.
    상대가 구독 중이 아니어도 아무 효과 없이 성공한다 — 받을 사람이 없는 것은 실패가 아니다.
    실패해도 재시도하지 않는 것이 정상이다.
    """
    notifyTyping(input: NotifyTypingInput!): NotifyTypingPayload!

    """
    대화를 읽은 것으로 표시한다. **호출 시점은 클라이언트가 정한다** —
    채팅방 진입·스크롤 하단 도달·포그라운드 복귀 등 어디서 부를지는 UX 판단이며,
    메시지를 조회하는 것만으로는 읽음 처리되지 않는다.

    같은 요청을 여러 번 보내도 안전하다 — 읽음 지점은 뒤로 가지 않는다.
    """
    markConversationRead(input: MarkConversationReadInput!): MarkConversationReadPayload!

    """
    DM 메시지 신고. 여러 건을 한 신고로 함께 접수한다.
    한 신고는 한 대화에 대한 것이며, 여러 대화의 메시지를 섞으면 거부된다.
    운영자는 여기에 포함된 메시지만 열람하며 대화 전체를 열지 않는다.
    누적 신고에 의한 자동 숨김은 적용되지 않는다 — 기록만 되고 조치는 사람이 판단한다.
    """
    reportMessages(input: ReportMessagesInput!): ReportMessagesPayload!
}

"""
실시간 구독. 인증은 연결 수립(connection_init) 시 1회 수행하고, 구독별 권한 검사는
subscribe 시점에 다시 한다.
"""
type Subscription {
    """
    상대의 타이핑 상태. 대화 참여자만 구독할 수 있으며, 아니면 구독 시작 시점에 FORBIDDEN이다.

    전달 보장이 없다 — 연결이 끊긴 동안의 이벤트는 유실되며 재연결해도 재전송되지 않는다.
    클라이언트는 후속 이벤트가 끊기면 표시를 자동으로 해제해야 한다.
    """
    typingIndicator(conversationId: ID!): TypingEvent!

    """
    대화에 도착한 새 메시지. 대화 참여자만 구독할 수 있으며, 아니면 구독 시작 시점에
    FORBIDDEN이다.

    **이 구독은 "새 메시지가 있다"는 신호이지 전달 보장 수단이 아니다.** 연결이 끊긴 동안의
    메시지는 이 스트림으로 오지 않으므로, 재연결 시 conversationMessages로 빈 구간을 메워야
    한다 — 서버의 원본은 언제나 DB다.

    본인이 보낸 메시지도 전달된다(다른 기기에서 보낸 경우가 있다). ownedByViewer로 구분한다.
    """
    newMessage(conversationId: ID!): Message!
}

"""
피드 항목. Post와 별개 타입이다 — 피드는 spot 1곳과 사진 1장 이상을 요구하는 반면
Post는 둘 다 선택이라 같은 타입에 이 제약을 얹을 수 없다.
"""
type FeedItem {
    id: ID!

    "1~500자."
    body: String!

    "연결된 장소. 피드는 항상 정확히 1곳을 가진다 — Post.spot과 달리 non-null이다."
    spot: PostSpot!

    """
    업로드를 마친 오브젝트 키. 1~5개이며 배열 순서가 표시 순서다.
    Post.photoKeys와 달리 비어 있을 수 없다.
    서버는 이미지 바이트를 중계하지 않으며, 클라이언트가 CDN 베이스 URL과 조합해 쓴다.
    """
    photoKeys: [String!]!

    author: PostAuthor!

    likeCount: Int!

    "호출자가 좋아요했는지."
    likedByViewer: Boolean!

    "호출자가 작성자인지. 클라이언트의 삭제·신고 수단 노출 여부를 결정한다."
    ownedByViewer: Boolean!

    "ISO-8601. 정렬 기준이다."
    createdAt: String!
}

"""
정렬은 createdAt 내림차순 고정이며 정렬 인자가 없다.
총 개수는 제공하지 않으며 pageInfo.hasNextPage로 소진을 판정한다.
"""
type FeedConnection {
    edges: [FeedItemEdge!]!
    pageInfo: PageInfo!
}

type FeedItemEdge {
    cursor: String!
    node: FeedItem!
}

input CreateFeedItemInput {
    "1~500자. 앞뒤 공백은 제거된 뒤 판정한다."
    body: String!

    "연결할 장소. 필수다. 언어와 무관한 장소 식별자로, Spot.id·PostSpot.id를 그대로 쓴다."
    catalogId: ID!

    """
    confirmPostImageUploads가 반환한 확정 키. 1~5개이며 배열 순서가 표시 순서다.
    6개 이상이면 앞 5개만 취하지 않고 TOO_MANY_PHOTOS로 거부된다.
    """
    photoKeys: [String!]!
}

type CreateFeedItemPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!

    "생성된 피드의 id. 성공 시에만 채워진다."
    feedItemId: ID
}

input LikeFeedItemInput {
    feedItemId: ID!
}

type LikeFeedItemPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!

    "연산 후의 좋아요 수."
    likeCount: Int
}

input UnlikeFeedItemInput {
    feedItemId: ID!
}

type UnlikeFeedItemPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    likeCount: Int
}

"""
1:1 대화. 그룹 대화는 다루지 않는다.

**대화가 시작된 피드를 담지 않는다** — 같은 상대와의 방은 하나인데 피드는 여러 개라
방 단위 맥락이 성립하지 않는다. 피드 인용은 Message.feedItem으로 메시지마다 붙는다.
"""
type Conversation {
    id: ID!

    "상대방. 1:1이므로 단일 필드로 충분하다."
    counterpart: PostAuthor!

    "가장 최근 메시지. 대화 시작과 첫 전송이 별개 호출이라 빈 대화가 존재할 수 있어 nullable이다."
    lastMessage: Message

    """
    호출자 기준 읽지 않은 메시지 수. 내가 보낸 메시지는 세지 않는다.
    `markConversationRead`를 호출하기 전까지 줄어들지 않는다.
    """
    unreadCount: Int!

    "정렬 기준. 최근 메시지 시각이며, 메시지가 없으면 대화 생성 시각이다. ISO-8601."
    updatedAt: String!
}

"정렬은 updatedAt 내림차순이다."
type ConversationConnection {
    edges: [ConversationEdge!]!
    pageInfo: PageInfo!
}

type ConversationEdge {
    cursor: String!
    node: Conversation!
}

type Message {
    id: ID!

    """
    1~1000자. 서버에 암호화되어 저장되며 조회 시 복원된다.
    **첨부만 보낸 메시지는 빈 문자열이다** — 사진이나 피드 인용만 보낼 수 있다.
    """
    body: String!

    """
    인용한 피드. 피드를 보고 보낸 메시지에 딸려 붙으며, 그 피드가 삭제되면 null이 되고
    메시지는 남는다. 대화방이 아니라 **메시지마다** 붙는 값이다.
    """
    feedItem: FeedItem

    """
    첨부 사진의 오브젝트 키. confirmPostImageUploads가 확정한 키다.
    서버는 이미지 바이트를 중계하지 않으며, 클라이언트가 CDN 베이스 URL과 조합해 쓴다.
    """
    photoKey: String

    sender: PostAuthor!

    "호출자가 보낸 메시지인지. 클라이언트의 말풍선 정렬을 결정한다."
    ownedByViewer: Boolean!

    "ISO-8601. 정렬 기준이다."
    createdAt: String!
}

"정렬은 createdAt 내림차순이다 — 채팅 화면은 위로 올릴수록 과거를 더 불러온다."
type MessageConnection {
    edges: [MessageEdge!]!
    pageInfo: PageInfo!
}

type MessageEdge {
    cursor: String!
    node: Message!
}

input StartConversationInput {
    "대화를 시작할 피드. 이 피드의 작성자가 상대방이 된다."
    feedItemId: ID!
}

type StartConversationPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!

    "생성되었거나 기존에 있던 대화의 id."
    conversationId: ID
}

input SendMessageInput {
    conversationId: ID!

    """
    1~1000자. 앞뒤 공백은 제거된 뒤 판정하며, 상한을 넘으면 잘리지 않고 거부된다.
    **첨부가 있으면 빈 문자열이어도 된다.** body·feedItemId·photoKey가 모두 비면 거부된다.
    """
    body: String!

    "인용할 피드. 피드를 보고 바로 메시지를 보낼 때 쓴다."
    feedItemId: ID

    "첨부할 사진. confirmPostImageUploads가 반환한 확정 키를 그대로 쓴다."
    photoKey: String
}

type SendMessagePayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!

    "생성된 메시지의 id. 성공 시에만 채워진다."
    messageId: ID
}

input NotifyTypingInput {
    conversationId: ID!
}

type NotifyTypingPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}

input MarkConversationReadInput {
    conversationId: ID!

    """
    여기까지 읽은 것으로 표시한다. **생략하면 그 대화의 마지막 메시지까지**로 본다 —
    "모두 읽음"을 표현하는 방법이며, 마지막 메시지 id를 몰라도 부를 수 있다.
    """
    upToMessageId: ID
}

type MarkConversationReadPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!

    "처리 후 남은 안 읽은 메시지 수. 클라이언트가 뱃지를 다시 조회하지 않아도 되도록 돌려준다."
    unreadCount: Int!
}

input ReportMessagesInput {
    "신고 대상 메시지. 1건 이상이며 모두 같은 대화에 속해야 한다. 자기 메시지는 담을 수 없다."
    messageIds: [ID!]!

    reason: ReportReason!

    "자유 서술. reason이 OTHER이면 필수 — 기존 reportContent와 같은 규약이다."
    detail: String
}

type ReportMessagesPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}

"""
타이핑 이벤트. 영속화되지 않으므로 이후 쿼리로 다시 조회할 방법이 없다 —
전달 시점의 스냅샷이다.
"""
type TypingEvent {
    "타이핑 중인 상대방."
    sender: PostAuthor!

    """
    발생 시각(ISO-8601). 클라이언트가 일정 시간 후 표시를 자동으로 내리는 판단에 쓴다.
    이벤트가 유실돼 화면이 "입력 중"에 갇히는 것을 막기 위한 값이다.
    """
    emittedAt: String!
}
