extend type Query {
    """
    글 피드. 최신순. 인자 조합으로 범위가 정해진다:
      - targetType·targetId  : 그 대상 하나에 붙은 글 (spot 상세 화면)
      - latitude·longitude   : 좌표 반경 안의 대상들에 붙은 글 (커뮤니티 탭)
      - 둘 다 없으면          : 전체 피드
    좌표를 줄 때만 radiusMeters·category가 의미를 갖는다.
    """
    posts(
        "대상 하나로 좁힌다. targetId와 함께 줘야 한다."
        targetType: PostTargetType
        targetId: ID
        "좌표 반경으로 좁힌다. longitude와 함께 줘야 한다."
        latitude: Float
        longitude: Float
        "검색 반경(미터). 좌표를 줄 때만 쓰인다. 기본 20000, 상한 100000 — 초과 시 절삭."
        radiusMeters: Int = 20000
        "상단 추천 칩. 대상의 카테고리로 거른다. 좌표를 줄 때만 쓰인다."
        category: TargetCategory
        "주제 태그 하나로 필터링. 생략하면 전체."
        topic: PostTopic
        first: Int = 20
        after: String
    ): PostConnection!

    "글의 댓글 목록. 최신순. 피드와 동일하게 차단·숨김이 걸러진다."
    comments(postId: ID!, first: Int = 20, after: String): CommentConnection!

    "글 단건. 차단 관계의 작성자이거나 자동 숨김된 글은 작성자 본인이 아닌 한 null이다. 삭제된 글도 null이며, 모두 오류가 아니라 통상적인 부재다."
    post(id: ID!): Post

    "호출자가 차단한 사용자 목록."
    blockedUsers(first: Int = 20, after: String): BlockedUserConnection!

    "커뮤니티 상단 카테고리 칩. 앱(X-App-Key 헤더)과 언어(Accept-Language)마다 구성이 다르다. 표시 문구는 내려주지 않는다 — 클라이언트가 category를 매핑한다. 구성이 없으면 빈 목록이며 오류가 아니다."
    communityChips: [CommunityChip!]!
}

extend type Mutation {
    "글 생성. 본문·spot·주제 태그 필수, 본문 1~500자. photoKeys는 confirmPostImageUpload를 통과한 키여야 한다."
    createPost(input: CreatePostInput!): CreatePostPayload!

    "본인 글의 제목·본문 수정. 사진·주제·대상은 바꿀 수 없다. 신고 누적으로 숨겨진 글은 수정할 수 없다(POST_NOT_EDITABLE)."
    editPost(input: EditPostInput!): EditPostPayload!

    "본인 글 삭제. 타인의 글은 거부된다."
    deletePost(input: DeletePostInput!): DeletePostPayload!

    "댓글 작성. 1단계만 — 대댓글 없음."
    createComment(input: CreateCommentInput!): CreateCommentPayload!

    "본인 댓글 삭제."
    deleteComment(input: DeleteCommentInput!): DeleteCommentPayload!

    "좋아요. 멱등 — 이미 좋아요한 글에 다시 호출해도 중복 집계되지 않는다."
    likePost(input: LikePostInput!): LikePostPayload!

    "좋아요 취소. 멱등 — 좋아요하지 않은 글에 호출해도 오류가 아니다."
    unlikePost(input: UnlikePostInput!): UnlikePostPayload!

    "사진 1장에 대한 presigned PUT URL 발급. 인증 필요, 단일 키 스코프, 5분 만료. contentType과 contentLength가 서명에 포함되므로 업로드 시 선언한 값과 정확히 일치해야 한다. 실제 업로드는 클라이언트가 오브젝트 스토리지로 직접 PUT하며 GraphQL을 거치지 않는다."
    createPostImageUploadUrl(input: CreatePostImageUploadUrlInput!): CreatePostImageUploadUrlPayload!

    "업로드 완료 확인. 서버가 실제 크기와 매직바이트를 검증하고, 통과하면 오브젝트를 확정 위치로 옮긴 뒤 최종 키를 반환한다. createPost에는 이 키를 넘긴다."
    confirmPostImageUpload(input: ConfirmPostImageUploadInput!): ConfirmPostImageUploadPayload!

    "사용자 차단. 양방향 — 차단 후 서로의 글·댓글이 모든 피드에서 보이지 않는다."
    blockUser(input: BlockUserInput!): BlockUserPayload!

    "차단 해제."
    unblockUser(input: UnblockUserInput!): UnblockUserPayload!

    "글·댓글·사용자 신고. 같은 대상을 두 번 신고할 수 없다."
    reportContent(input: ReportContentInput!): ReportContentPayload!
}

"글의 주제 태그. 고정 세트이며 글당 정확히 하나다. 표시 문자열은 클라이언트가 매핑한다."
enum PostTopic {
    QUESTION
    TIP
    REVIEW
    COMPANION
    PHOTO
}

"글이 붙을 수 있는 대상의 종류. 값이 늘어도 기존 값의 의미는 바뀌지 않는다."
enum PostTargetType {
    SPOT
}

"대상의 카테고리. 커뮤니티 상단 추천 칩이 이 축으로 피드를 거른다. tourism의 SpotCategory와 값이 같다."
enum TargetCategory {
    TOURIST_SPOT
    CULTURAL_FACILITY
    FESTIVAL_EVENT
    TRAVEL_COURSE
    LEISURE_SPORTS
    LODGING
    SHOPPING
    RESTAURANT
    TRANSPORT
}

"피드 카드의 대상 칩에 필요한 최소 정보. 종류가 무엇이든 같은 모양이다."
type PostTarget {
    type: PostTargetType!
    "그 종류 안에서의 id. SPOT이면 요청 언어 기준 spot.id이며 Query.spotDetail(id:)에 그대로 넘길 수 있다."
    id: ID!
    title: String!
    thumbnailImageUrl: String!
    "상단 추천 칩이 거르는 축. 카테고리 개념이 없는 종류는 null이다."
    category: TargetCategory
}

type Post {
    id: ID!
    "글 제목. 1~50자. 카드에서 볼드로 표시된다."
    title: String!
    "1~500자."
    body: String!
    topic: PostTopic!
    "글이 붙은 대상. 카드의 칩이 이 값으로 그려진다."
    target: PostTarget!
    author: PostAuthor!
    "업로드를 마친 오브젝트 키. 최대 5개, 첨부 순서대로. 서버는 이미지 바이트를 중계하지 않으며, 클라이언트가 CDN 베이스 URL과 조합해 사용한다."
    photoKeys: [String!]!
    likeCount: Int!
    "숨겨진 댓글은 제외한 수. 모든 호출자에게 같은 값이며, 자기 댓글이 숨겨진 사용자에게도 동일하다."
    commentCount: Int!
    "호출자가 좋아요했는지."
    likedByViewer: Boolean!
    "호출자가 작성자인지. 클라이언트의 수정·삭제 수단 노출 여부를 결정한다."
    ownedByViewer: Boolean!
    "신고 누적으로 자동 숨김되었는지. 작성자가 아닌 호출자에게는 애초에 결과에 포함되지 않으므로, 작성자 본인만 이 값이 true인 자기 글을 본다."
    hidden: Boolean!
    "수정된 적이 있는지. 클라이언트가 \"수정됨\"을 표시한다."
    edited: Boolean!
    "ISO-8601. 정렬 기준."
    createdAt: String!
    """
    댓글 미리보기. 최신순 몇 건만 내려주며 **페이지네이션이 없다** —
    목록 안에 목록을 중첩하면 커서 관리가 화면마다 갈린다.
    전체 목록과 더 보기는 루트의 comments(postId:)를 쓴다.
    피드와 동일하게 차단·숨김이 걸러지며, 전체 개수는 commentCount다.
    """
    commentPreview: [Comment!]!
}

"글·댓글에 실리는 최소 작성자 정보."
type PostAuthor {
    id: ID!
    nickname: String!
    profileImageUrl: String
}

type Comment {
    id: ID!
    "1~500자. 글 본문과 같은 범위를 적용한다."
    body: String!
    author: PostAuthor!
    ownedByViewer: Boolean!
    hidden: Boolean!
    createdAt: String!
}

"정렬: createdAt 내림차순. 기본 20, 상한 50 — 초과 요청은 상한으로 절삭된다. 총 개수는 제공하지 않으며 pageInfo.hasNextPage로 소진을 판정한다."
type PostConnection {
    edges: [PostEdge!]!
    pageInfo: PageInfo!
}

type PostEdge {
    cursor: String!
    node: Post!
}

"정렬: createdAt 내림차순. 기본 20, 상한 50 — 초과 요청은 상한으로 절삭된다."
type CommentConnection {
    edges: [CommentEdge!]!
    pageInfo: PageInfo!
}

type CommentEdge {
    cursor: String!
    node: Comment!
}

"정렬: 차단 시각 내림차순. 기본 20, 상한 50 — 초과 요청은 상한으로 절삭된다."
type BlockedUserConnection {
    edges: [BlockedUserEdge!]!
    pageInfo: PageInfo!
}

type BlockedUserEdge {
    cursor: String!
    node: PostAuthor!
    "차단 시각(ISO-8601). 정렬 기준."
    blockedAt: String!
}

"커뮤니티 상단의 카테고리 칩 하나. 누르면 nearbyPosts(category:)로 그 카테고리의 글만 조회한다."
type CommunityChip {
    category: TargetCategory!
    "표시 순서. 작은 값이 왼쪽이다."
    position: Int!
}

input CreatePostInput {
    targetType: PostTargetType!
    targetId: ID!
    topic: PostTopic!
    "1~50자. 앞뒤 공백은 제거된 뒤 판정한다."
    title: String!
    "1~500자. 앞뒤 공백은 제거된 뒤 판정한다."
    body: String!
    "confirmPostImageUpload가 반환한 키. 최대 5개이며 배열 순서가 표시 순서다. 빈 목록도 유효하다 — 사진은 선택이다."
    photoKeys: [String!]!
}

type CreatePostPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    "생성된 글의 id. 성공 시 채워진다. 글 내용은 이 id로 Query.post를 조회한다."
    postId: ID
    "항상 null이다. spot·author가 요청 시에만 조회되는 지연 필드라 생성 응답에서 조립하지 않는다 — postId로 다시 조회할 것."
    post: Post
}

input EditPostInput {
    postId: ID!
    "1~50자."
    title: String!
    "1~500자."
    body: String!
}

type EditPostPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}

input DeletePostInput {
    postId: ID!
}

type DeletePostPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}

input CreateCommentInput {
    postId: ID!
    body: String!
}

type CreateCommentPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    "생성된 댓글의 id. 성공 시 채워진다."
    commentId: ID
    "항상 null이다. 이유는 CreatePostPayload.post와 같다 — commentId와 comments(postId:)로 조회할 것."
    comment: Comment
}

input DeleteCommentInput {
    commentId: ID!
}

type DeleteCommentPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}

input LikePostInput {
    postId: ID!
}

type LikePostPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    "연산 후의 좋아요 수."
    likeCount: Int
}

input UnlikePostInput {
    postId: ID!
}

type UnlikePostPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    likeCount: Int
}

input CreatePostImageUploadUrlInput {
    "선언한 MIME 타입. image/jpeg · image/png · image/webp만 허용되며 그 외에는 URL을 발급하지 않는다. 서명에 포함되므로 업로드 요청의 Content-Type과 정확히 일치해야 한다."
    contentType: String!
    "선언한 바이트 크기. 상한 10485760(10MiB)이며 초과 시 URL을 발급하지 않는다. 서명에 포함되므로 업로드 요청의 Content-Length와 정확히 일치해야 한다."
    contentLength: Int!
}

type CreatePostImageUploadUrlPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    "presigned PUT URL. 단일 오브젝트 키 스코프, 5분 만료."
    uploadUrl: String
    "이 URL이 가리키는 임시 오브젝트 키. 업로드 후 confirmPostImageUpload로 되돌려준다."
    objectKey: String
    "발급 시각 + 5분(ISO-8601)."
    expiresAt: String
}

input ConfirmPostImageUploadInput {
    "createPostImageUploadUrl이 반환한 임시 키."
    objectKey: String!
}

type ConfirmPostImageUploadPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    "검증을 통과해 확정 위치로 옮겨진 최종 키. CreatePostInput.photoKeys로 넘긴다."
    objectKey: String
}

input BlockUserInput {
    targetMemberId: ID!
}

type BlockUserPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}

input UnblockUserInput {
    targetMemberId: ID!
}

type UnblockUserPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}

enum ReportTargetType {
    POST
    COMMENT
    "사용자 대상 신고는 기록만 되며 누적되어도 자동 조치가 없다. 자동 숨김은 POST·COMMENT에만 적용된다."
    MEMBER
}

"신고 사유 고정 집합."
enum ReportReason {
    SPAM
    ABUSE
    INAPPROPRIATE_CONTENT
    OTHER
}

input ReportContentInput {
    targetType: ReportTargetType!
    targetId: ID!
    reason: ReportReason!
    "자유 서술. reason이 OTHER이면 필수 — 서버가 검증한다."
    detail: String
}

type ReportContentPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}
