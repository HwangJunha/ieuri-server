enum ReportTargetType {
    POST
    COMMENT
    "사용자 대상 신고는 기록만 되며 누적되어도 자동 조치가 없다. 자동 숨김은 공개 콘텐츠(POST·COMMENT·FEED_ITEM)에만 적용된다."
    MEMBER
    "피드 신고. 공개 콘텐츠라 글과 같은 누적 자동 숨김이 적용된다. DM 메시지는 이 열거형을 쓰지 않고 reportMessages를 쓴다."
    FEED_ITEM
}

"신고 사유 고정 집합."
enum ReportReason {
    SPAM
    ABUSE
    INAPPROPRIATE_CONTENT
    OTHER
}

input ReportContentInput {
    targetType: ReportTargetType!
    targetId: ID!
    reason: ReportReason!
    "자유 서술. reason이 OTHER이면 필수 — 서버가 검증한다."
    detail: String
}

type ReportContentPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}
