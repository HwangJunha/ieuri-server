type Query {
    "GraphQL 스키마 헬스 체크(루트 Query 필요)."
    authHealth: String!
    "본인 정보. accessToken 인증만 필요(권한 불요). 역할/유효권한을 담아 클라이언트 메뉴 렌더에 사용한다."
    me: Me!
    "관리자 회원 단건 조회. member:read 권한 필요."
    member(id: ID!): MemberDetail!
    "관리자 회원 목록(커서 페이지네이션). member:read 권한 필요. 목록은 이메일을 포함하지 않는다(최소수집)."
    members(status: MemberStatus, roleCode: String, first: Int = 20, after: String): MemberConnection!
    "할당 가능한 역할 목록. role:assign 권한이 필요하다."
    assignableRoles: [RoleInfo!]!
    "호출자의 약관별 동의 상태. 필수·선택을 모두 포함한다. required가 참이면서 agreed가 거짓인 항목이 있으면 클라이언트가 이용 게이트를 건다."
    agreements: [AgreementStatus!]!
}

type Mutation {
    "SNS 회원가입. 가입은 이메일 검증 완료를 기다리지 않고 성공 처리된다."
    registerSnsMember(input: RegisterSnsMemberInput!): RegisterSnsMemberPayload!
    "자체(이메일) 회원가입. 이메일+비밀번호로 가입하고 이메일 인증으로 활성화한다."
    registerEmailMember(input: RegisterEmailMemberInput!): RegisterEmailMemberPayload!
    "이메일 검증 코드 확인."
    verifyEmail(input: VerifyEmailInput!): VerifyEmailPayload!
    "이메일 검증 코드 재발송."
    resendVerification(input: ResendVerificationInput!): ResendVerificationPayload!
    "SNS 로그인. 기존 회원만 인증하며 accessToken/refreshToken을 발급한다."
    loginSns(input: LoginSnsInput!): AuthTokenPayload!
    "자체(이메일) 로그인. 비밀번호를 검증하고 토큰을 발급한다. 이메일 인증을 마치지 않은 회원도 성공하며, 그 토큰으로는 me·verifyEmail·resendVerification·retargetEmailVerification·withdrawMember·refreshToken·logout만 호출할 수 있고 나머지는 EMAIL_NOT_VERIFIED 최상위 오류로 거절된다."
    loginEmail(input: LoginEmailInput!): AuthTokenPayload!
    "비밀번호 재설정 요청. 가입된 이메일 회원에게만 코드를 발송한다. 미가입 주소는 MEMBER_NOT_FOUND, SNS 계정은 NOT_EMAIL_MEMBER로 거부하므로 클라이언트가 코드 입력 화면으로 넘어갈지 판단할 수 있다. 재발송 쿨다운 60초."
    requestPasswordReset(input: RequestPasswordResetInput!): RequestPasswordResetPayload!
    "비밀번호 재설정 실행. 이메일+코드 검증 성공 시 새 비밀번호로 교체하고 기존 세션을 폐기한다."
    resetPassword(input: ResetPasswordInput!): ResetPasswordPayload!
    "refreshToken으로 accessToken 재발급(refresh 회전)."
    refreshToken(input: RefreshTokenInput!): AuthTokenPayload!
    "로그아웃. 제출한 refreshToken을 폐기한다."
    logout(input: LogoutInput!): LogoutPayload!
    "회원 탈퇴(본인). accessToken 인증 필요. 회원과 소유 데이터가 삭제된다."
    withdrawMember: WithdrawMemberPayload!
    "회원 정지(관리자). member:suspend 권한 필요."
    suspendMember(input: SuspendMemberInput!): AdminActionPayload!
    "회원 정지 해제(관리자). member:reactivate 권한 필요."
    reactivateMember(input: ReactivateMemberInput!): AdminActionPayload!
    "역할 부여(관리자). role:assign 권한 필요."
    assignRole(input: AssignRoleInput!): RoleChangePayload!
    "역할 회수(관리자). role:revoke 권한 필요. 본인의 마지막 관리 역할 회수는 거부된다."
    revokeRole(input: RevokeRoleInput!): RoleChangePayload!
    "닉네임 변경. 회원 간 고유해야 하며 중복 시 실패한다."
    changeNickname(input: ChangeNicknameInput!): ChangeNicknamePayload!
    "프로필 이미지 업로드용 presigned PUT URL 발급. profile 네임스페이스의 단일 오브젝트 키를 쓴다(게시물 이미지 키와 분리된다). 실제 업로드는 클라이언트가 오브젝트 스토리지로 직접 PUT하며 GraphQL을 거치지 않는다."
    createProfileImageUploadUrl(input: CreateProfileImageUploadUrlInput!): CreateProfileImageUploadUrlPayload!
    "프로필 이미지 업로드 완료 확인. 서버가 실제 크기와 매직바이트를 검증하고 통과하면 확정 위치로 옮겨 회원에 반영한다."
    confirmProfileImageUpload(input: ConfirmProfileImageUploadInput!): ConfirmProfileImageUploadPayload!
    "프로필 이미지 제거. 멱등 — 이미 없어도 성공한다."
    removeProfileImage: RemoveProfileImagePayload!
    "약관 동의를 개별로 켜고 끈다. 필수 약관도 철회할 수 있으며, 철회하면 required가 참이면서 agreed가 거짓인 상태가 되어 클라이언트가 이용 게이트를 건다. 서버는 철회한 회원의 다른 오퍼레이션을 거절하지 않는다."
    updateAgreement(input: UpdateAgreementInput!): UpdateAgreementPayload!
    "이메일 변경 요청. 새 주소로 6자리 코드를 발송한다. confirmEmailChange를 통과하기 전까지 Me.email은 기존 값으로 유지된다. **Provider.EMAIL 회원만 사용할 수 있다** — SNS 회원은 NOT_EMAIL_MEMBER로 거절된다(Me.canChangeEmail로 미리 판단할 수 있다). 이미 인증을 마친 주소를 바꾸는 경로이며, 아직 인증하지 않은 대기 주소의 정정은 retargetEmailVerification이 맡는다."
    changeEmail(input: ChangeEmailInput!): ChangeEmailPayload!
    "이메일 변경 코드 확인. 통과하면 Me.email이 새 주소로 교체된다."
    confirmEmailChange(input: ConfirmEmailChangeInput!): ConfirmEmailChangePayload!
    "이메일 변경 코드 재발송. changeEmail이 발급한 핸들을 재사용하며 대상 주소는 그대로다. 쿨다운 60초."
    resendEmailChange(input: ResendEmailChangeInput!): ResendEmailChangePayload!
    "인증 대기 주소를 정정한다. 아직 인증을 마치지 않은 회원만 사용할 수 있고, 마친 회원은 실패한다(그쪽은 changeEmail의 몫). 가입 유형을 가리지 않는다 — 이메일 가입자와 provider가 이메일을 주지 않은 SNS 가입자가 함께 쓴다. 이전 가입 인증 코드는 무효화되고 새 주소로 코드가 발송되며, 진행 중인 이메일 변경 검증은 영향을 받지 않는다. 쿨다운 60초를 resendVerification과 같은 창으로 공유한다."
    retargetEmailVerification(input: RetargetEmailVerificationInput!): RetargetEmailVerificationPayload!
    "미동의 상태인 필수 약관에 동의한다. 동의만 받으며 철회는 받지 않는다 — 필수 약관 철회는 사실상 서비스 이용 중단이므로 탈퇴로만 가능하다. 모든 필수 약관이 동의되면 이용 게이트가 해제된다."
    agreeToRequiredTerms(input: AgreeToRequiredTermsInput!): AgreeToRequiredTermsPayload!
}

"약관 1건에 대한 호출자의 동의 상태."
type AgreementStatus {
    termsCode: TermsCode!
    "필수 약관 여부. 참이면 미동의 시 이용 게이트 대상이다."
    required: Boolean!
    "현재 시행 중인 버전에 대한 동의 여부. 새 버전이 시행되면 이전 버전의 동의는 이월되지 않으므로 거짓이 된다."
    agreed: Boolean!
    "현재 시행 중인 버전에 동의한 시각(ISO-8601). 미동의 상태면 null이다."
    agreedAt: String
    "현재 시행 중인 약관 문서 버전."
    version: String!
}

input ChangeNicknameInput {
    "앞뒤 공백은 제거되어 저장된다. 2자 이상 20자 이하."
    nickname: String!
}

type ChangeNicknamePayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    "성공 시 반영된 닉네임."
    nickname: String
}

input CreateProfileImageUploadUrlInput {
    "image/jpeg · image/png · image/webp만 허용된다. 서명에 포함되므로 업로드 요청의 Content-Type과 정확히 일치해야 한다."
    contentType: String!
    "선언한 바이트 크기. 상한 10485760(10MiB). 서명에 포함되므로 Content-Length와 정확히 일치해야 한다."
    contentLength: Int!
}

type CreateProfileImageUploadUrlPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    "presigned PUT URL. 단일 오브젝트 키 스코프. 실패 시 null."
    uploadUrl: String
    "업로드 후 confirmProfileImageUpload로 되돌려줄 임시 오브젝트 키. profile 네임스페이스."
    objectKey: String
    "발급 시각 + 30분(ISO-8601)."
    expiresAt: String
}

input ConfirmProfileImageUploadInput {
    "createProfileImageUploadUrl이 반환한 임시 키."
    objectKey: String!
}

type ConfirmProfileImageUploadPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    "반영된 최종 오브젝트 키. 서버는 이미지 바이트를 중계하지 않으며 클라이언트가 CDN 베이스 URL과 조합해 사용한다."
    profileImageKey: String
}

type RemoveProfileImagePayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}

input RetargetEmailVerificationInput {
    "새로 인증받을 이메일 주소. 같은 provider의 다른 회원이 쓰는 주소면 실패한다."
    newEmail: String!
}

type RetargetEmailVerificationPayload implements BaseResponse {
    success: Boolean!
    """
    ALREADY_VERIFIED(인증을 이미 마침 → 인증 화면 이탈) · EMAIL_ALREADY_IN_USE(같은 provider에 중복) ·
    RESEND_COOLDOWN_ACTIVE(60초 이내 재요청) · MEMBER_NOT_FOUND · INVALID_INPUT(주소 형식).
    """
    userErrors: [UserError!]!
    "재발급된 검증 핸들. 이후 verifyEmail·resendVerification에 쓴다. 실패 시 null."
    verificationId: String
    "새 코드의 만료 시각. 발급 시각 + 10분(ISO-8601). 실패 시 null."
    expiresAt: String
}

input ChangeEmailInput {
    "새 이메일 주소. 현재 값과 같거나 다른 회원이 쓰는 주소면 실패한다."
    newEmail: String!
}

type ChangeEmailPayload implements BaseResponse {
    success: Boolean!
    """
    NOT_EMAIL_MEMBER(SNS 회원 → Me.canChangeEmail로 미리 판단) · SAME_AS_CURRENT_EMAIL ·
    EMAIL_ALREADY_IN_USE · INVALID_EMAIL_FORMAT · MEMBER_NOT_FOUND.
    """
    userErrors: [UserError!]!
    "코드 검증에 사용할 핸들. 실패 시 null."
    verificationId: String
    "발급 시각 + 10분(ISO-8601)."
    expiresAt: String
}

input ConfirmEmailChangeInput {
    verificationId: String!
    code: String!
}

type ConfirmEmailChangePayload implements BaseResponse {
    success: Boolean!
    """
    VERIFICATION_NOT_FOUND(핸들이 없거나 남의 것이거나 가입 인증 핸들) · EMAIL_ALREADY_IN_USE
    (요청 후 확인 사이에 선점됨) · MEMBER_NOT_FOUND · INVALID_INPUT(코드 형식).
    **코드가 틀린 것은 오류가 아니다** — success=true에 failureReason으로 온다.
    """
    userErrors: [UserError!]!
    "성공 시 반영된 새 이메일."
    email: String
    "실패 사유(EXPIRED/CONSUMED/MAX_ATTEMPTS_EXCEEDED/CODE_MISMATCH). 성공 시 null. 기존 VerifyEmailPayload와 동일한 어휘를 쓴다."
    failureReason: String
}

input ResendEmailChangeInput {
    verificationId: String!
}

type ResendEmailChangePayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    verificationId: String
    expiresAt: String
}

input UpdateAgreementInput {
    "시행 중인 약관이어야 한다. 필수·선택을 가리지 않는다."
    termsCode: TermsCode!
    agreed: Boolean!
}

type UpdateAgreementPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    "반영 후의 상태."
    agreement: AgreementStatus
}

input AgreeToRequiredTermsInput {
    "동의할 필수 약관 코드. 미동의 상태인 필수 약관을 한 번에 넘긴다. 선택 약관 코드를 넣으면 실패한다."
    termsCodes: [TermsCode!]!
}

type AgreeToRequiredTermsPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    "반영 후 전체 약관 상태. 클라이언트가 게이트 해제 여부를 이 값으로 재계산한다."
    agreements: [AgreementStatus!]!
}

"모든 mutation 응답이 구현하는 공통 규약. success와 도메인 검증 실패(userErrors)를 담는다."
interface BaseResponse {
    "유스케이스가 성공했는지. 실패 시 userErrors가 채워진다."
    success: Boolean!
    "예상 가능한 도메인/입력 검증 실패 목록. 시스템/인증 오류는 최상위 errors로 전달된다."
    userErrors: [UserError!]!
}

"사용자에게 보여줄 수 있는 도메인/입력 검증 오류."
type UserError {
    """
    머신 판독용 코드. 값의 목록은 ErrorCode에 있다 — 새 코드가 늘어도 깨지지 않도록 String으로 두고,
    코드젠으로 받을 수 있는 형태가 필요하면 codeValue를 쓴다.
    """
    code: String!
    """
    code와 같은 값을 enum으로 준다. 클라이언트가 분기를 컴파일 타임에 고정할 때 쓴다.
    이 스키마가 아직 모르는 코드가 오면 null이다 — 그 경우 code를 그대로 읽어 기본 처리한다.
    """
    codeValue: ErrorCode
    "사용자 노출 메시지. 그대로 노출해도 되며 개인정보를 담지 않는다(POL-013)."
    message: String!
    "관련 입력 필드 경로(있을 때). 예: input.email"
    field: String
}

"""
`userErrors[].code`로 올 수 있는 값. **payload의 오류만** 담는다 —
인증·인가·이메일 미인증은 payload가 아니라 최상위 `errors[].extensions.code`로 오며,
그 값은 TopLevelErrorCode에 적어 두었다(스키마 타입이 아니라 문서용 enum이다).

코드가 늘어날 수 있으므로 `UserError.code`(String)가 정본이고 이 enum은 편의 사본이다.
"""
enum ErrorCode {
    "입력 형식·도메인 불변식 위반. 어느 필드인지는 message가 설명한다."
    INVALID_INPUT
    "비밀번호가 정책(8~100자·영문·숫자·특수문자)을 만족하지 않는다. field=input.password."
    PASSWORD_POLICY_VIOLATION

    # ── 가입 ──
    "이미 가입된 계정((provider, provider_user_id) 중복)."
    MEMBER_ALREADY_REGISTERED
    "같은 provider에 같은 이메일이 이미 있다. 다른 provider의 같은 주소는 충돌이 아니다."
    EMAIL_ALREADY_IN_USE
    "SNS id_token 검증 실패(서명·발급자·만료). 사유는 일반화해 노출하지 않는다."
    SNS_VERIFICATION_FAILED

    # ── 로그인 ──
    "이메일 또는 비밀번호가 올바르지 않다. 계정 존재 여부는 드러내지 않는다."
    INVALID_CREDENTIALS
    "가입되지 않은 계정이거나 회원을 찾을 수 없다."
    MEMBER_NOT_FOUND
    "정지된 계정."
    ACCOUNT_INACTIVE

    # ── 이메일 인증 ──
    "검증 핸들에 해당하는 챌린지가 없다. 다른 목적의 핸들을 넘긴 경우도 같은 코드다."
    VERIFICATION_NOT_FOUND
    "재발송 rate limit(가입 인증)."
    VERIFICATION_RATE_LIMITED
    "재발송 쿨다운 60초 이내(이메일 변경·인증 주소 재입력)."
    RESEND_COOLDOWN_ACTIVE
    "이미 인증을 마쳐 인증 주소 재입력을 쓸 수 없다. 인증 화면을 벗어나야 한다."
    ALREADY_VERIFIED

    # ── 이메일 변경 ──
    "SNS 회원은 이메일을 변경할 수 없다. Me.canChangeEmail로 미리 판단할 수 있다."
    NOT_EMAIL_MEMBER
    "현재 사용 중인 주소와 같다."
    SAME_AS_CURRENT_EMAIL
    "이메일 형식이 올바르지 않다."
    INVALID_EMAIL_FORMAT

    # ── 프로필 ──
    "닉네임 길이·형식 규칙 위반."
    INVALID_NICKNAME
    "다른 회원이 이미 쓰는 닉네임."
    NICKNAME_ALREADY_TAKEN
    "허용하지 않는 이미지 형식."
    UNSUPPORTED_IMAGE_TYPE
    "선언한 이미지 크기가 상한을 넘는다."
    IMAGE_TOO_LARGE
    "이 회원에게 발급된 적 없는 오브젝트 키."
    OBJECT_KEY_NOT_FOUND
    "발급받았으나 실제 업로드가 확인되지 않은 키."
    PHOTO_NOT_UPLOADED

    # ── 약관·역할 ──
    "시행 중인 약관에서 코드를 찾을 수 없다."
    TERMS_NOT_FOUND
    "선택 약관을 필수 동의 경로로 제출했다."
    TERMS_CODE_NOT_REQUIRED
    "존재하지 않는 역할 코드."
    ROLE_NOT_FOUND
    "본인의 마지막 관리 역할을 스스로 회수하려 했다."
    SELF_DEMOTION
}

"""
최상위 `errors[].extensions.code`로 오는 값. **스키마 타입이 아니라 문서다** —
GraphQL 오류는 스키마로 형이 잡히지 않으므로 여기에 적어 클라이언트가 분기 근거로 삼는다.
payload의 `userErrors`와 달리 이 오류가 오면 `data`는 null이거나 아예 없다.
"""
enum TopLevelErrorCode {
    "인증이 필요하다(토큰 없음). 로그인 화면으로 보낸다."
    UNAUTHENTICATED
    "인증은 됐으나 권한이 없다."
    FORBIDDEN
    """
    이메일 인증을 마치지 않은 회원이 허용 목록 밖 오퍼레이션을 호출했다.
    허용 목록은 me·verifyEmail·resendVerification·retargetEmailVerification·withdrawMember·
    refreshToken·logout과 로그인·가입·비밀번호 재설정 계열이다. 인증 화면으로 보낸다.
    """
    EMAIL_NOT_VERIFIED
    "토큰 서명·만료·타입이 유효하지 않다. refreshToken으로 재발급을 시도한다."
    INVALID_TOKEN
    """
    이미 폐기된 refresh가 다시 제출됐다(탈취 의심). 회원의 모든 refresh가 폐기되므로
    재발급으로 회복되지 않는다 — 재로그인 화면으로 보낸다.
    """
    TOKEN_REUSE_DETECTED
    """
    인증 저장소에 일시적으로 닿지 못해 토큰을 판정할 수 없다.

    **토큰 문제가 아니다** — 재발급도 재로그인도 상황을 바꾸지 못하며, 재로그인시키면
    멀쩡한 세션을 버리게 된다. 잠시 후 같은 요청을 다시 보낸다.
    """
    AUTH_STORE_UNAVAILABLE
    """
    토큰이 제시됐으나 유효하지 않아 비로그인으로 처리됐다. 토큰을 보내지 않은 요청에는
    오지 않는다 — 그쪽은 로그인 자체를 하지 않은 상태다.

    갱신 후 같은 요청을 다시 보낸다. 갱신도 실패하면 재로그인 화면으로 보낸다.
    """
    UNAUTHENTICATED_TOKEN_REJECTED
    """
    소켓의 신원이 더 이상 유효하지 않아 구독을 열 수 없다(수명 초과 또는 폐기).

    **재연결이 아니라 갱신 후 재구독이다** — 소켓 신원은 connection_init에 고정되어 있어
    같은 토큰으로 다시 붙으면 결과가 같다. 토큰을 갱신하고 연결을 새로 맺어야 한다.
    기존에 열려 있는 구독은 끊기지 않는다.
    """
    SUBSCRIPTION_UNAUTHENTICATED
}

"회원 상태. 탈퇴는 행 삭제(hard delete)이므로 상태값에 없다."
enum MemberStatus {
    ACTIVE
    SUSPENDED
}

enum Provider {
    APPLE
    GOOGLE
    KAKAO
    "자체 가입(이메일+비밀번호). 이메일 변경이 가능한 유일한 유형이다."
    EMAIL
}

"약관 코드. 클라이언트가 동의 항목을 하드코딩 없이 렌더한다."
enum TermsCode {
    SERVICE
    PRIVACY
    LOCATION
    MARKETING
}

"할당 가능한 역할. code는 assignRole·revokeRole의 roleCode로 쓰는 값이다."
type RoleInfo {
    code: String!
    name: String!
    description: String
}

input RegisterSnsMemberInput {
    provider: Provider!
    "SNS id_token(또는 dev 토큰)."
    idToken: String!
    "폼 제출 이메일(필수). provider 값이 기본 채워지되 수정 가능."
    email: String!
    "만 14세 이상 확인."
    ageVerified: Boolean!
    agreements: [AgreementInput!]!
    "provider의 authorization code. 탈퇴 시 연결 해제에 쓸 토큰을 확보하는 데 사용한다. 생략하거나 확보에 실패해도 가입은 성공한다."
    authorizationCode: String
}

input AgreementInput {
    termsCode: TermsCode!
    agreed: Boolean!
}

input RegisterEmailMemberInput {
    email: String!
    "비밀번호. 영문·숫자·특수문자 3종 모두 포함, 8자 이상."
    password: String!
    "만 14세 이상 확인."
    ageVerified: Boolean!
    agreements: [AgreementInput!]!
}

input LoginEmailInput {
    email: String!
    password: String!
}

input RequestPasswordResetInput {
    email: String!
}

input ResetPasswordInput {
    email: String!
    "이메일로 받은 6자리 재설정 코드."
    code: String!
    "새 비밀번호. 영문·숫자·특수문자 3종 모두 포함, 8자 이상."
    newPassword: String!
}

input VerifyEmailInput {
    "가입 응답으로 받은 검증 핸들(email_verification.public_id)."
    verificationId: String!
    code: String!
}

input ResendVerificationInput {
    verificationId: String!
}

type RegisterSnsMemberPayload implements BaseResponse {
    success: Boolean!
    """
    SNS_VERIFICATION_FAILED(id_token 검증 실패) · MEMBER_ALREADY_REGISTERED ·
    EMAIL_ALREADY_IN_USE(같은 provider에 같은 주소) · INVALID_INPUT(약관 미동의·연령 등).
    """
    userErrors: [UserError!]!
    "성공 시 채워짐. 이메일 검증 완료 여부."
    emailVerified: Boolean
    "미검증인 경우에만 채워지는 검증 핸들."
    verificationId: String
}

type RegisterEmailMemberPayload implements BaseResponse {
    success: Boolean!
    """
    MEMBER_ALREADY_REGISTERED · EMAIL_ALREADY_IN_USE · INVALID_INPUT(이메일·비밀번호 정책·약관).
    """
    userErrors: [UserError!]!
    "이메일 인증 코드 검증에 사용할 핸들(가입 성공 시 채워짐)."
    verificationId: String
}

type RequestPasswordResetPayload implements BaseResponse {
    success: Boolean!
    """
    MEMBER_NOT_FOUND(가입되지 않은 주소 → 이메일 칸에 안내) ·
    NOT_EMAIL_MEMBER(SNS 계정 → 해당 SNS 로그인 안내) ·
    RESEND_COOLDOWN_ACTIVE(60초 이내 재요청).
    거부되면 코드 입력 화면으로 넘어가지 마세요 — 메일이 발송되지 않습니다.
    """
    userErrors: [UserError!]!
}

type ResetPasswordPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    """
    실패 사유(EXPIRED/CONSUMED/MAX_ATTEMPTS_EXCEEDED/CODE_MISMATCH). 성공 시 null.
    **CODE_MISMATCH는 코드 오타뿐 아니라 챌린지가 없는 경우도 포함한다** — 사유가 갈리면
    코드를 모르는 제3자가 회원 유무를 캐낼 수 있어 통일했다. 사용자에게는 "코드가 올바르지
    않거나 만료되었습니다"로 안내하면 된다.
    """
    failureReason: String
}

type VerifyEmailPayload implements BaseResponse {
    success: Boolean!
    """
    VERIFICATION_NOT_FOUND(핸들 없음 또는 이메일 변경 핸들) · EMAIL_ALREADY_IN_USE·MEMBER_NOT_FOUND
    (주소를 정정한 챌린지를 확정할 때) · INVALID_INPUT(코드 형식).
    **코드가 틀린 것은 오류가 아니다** — success=true에 verified=false, failureReason으로 온다.
    """
    userErrors: [UserError!]!
    "코드 검증 결과(성공 시 채워짐)."
    verified: Boolean
    "실패 사유(EXPIRED/CONSUMED/MAX_ATTEMPTS_EXCEEDED/CODE_MISMATCH). 성공 시 null."
    failureReason: String
}

type ResendVerificationPayload implements BaseResponse {
    success: Boolean!
    """
    VERIFICATION_NOT_FOUND(핸들 없음 또는 이메일 변경 핸들) · VERIFICATION_RATE_LIMITED(60초 쿨다운).
    쿨다운 창은 retargetEmailVerification과 공유하지만 그쪽 코드는 RESEND_COOLDOWN_ACTIVE다.
    """
    userErrors: [UserError!]!
    verificationId: String
    expiresAt: String
}

input LoginSnsInput {
    provider: Provider!
    "SNS id_token(또는 dev 토큰)."
    idToken: String!
    "provider의 authorization code. 폐기용 토큰이 아직 없는 회원의 토큰을 보충한다. 없으면 보충하지 않을 뿐 로그인은 성공한다."
    authorizationCode: String
}

input RefreshTokenInput {
    refreshToken: String!
}

input LogoutInput {
    refreshToken: String!
}

type AuthTokenPayload implements BaseResponse {
    success: Boolean!
    """
    loginEmail: INVALID_CREDENTIALS · ACCOUNT_INACTIVE · MEMBER_NOT_FOUND.
    loginSns: SNS_VERIFICATION_FAILED · MEMBER_NOT_FOUND(미가입 → 가입 유도) · ACCOUNT_INACTIVE.
    refreshToken: 토큰 실패는 payload가 아니라 최상위 오류다 —
    INVALID_TOKEN(재발급 시도) · TOKEN_REUSE_DETECTED(재로그인 필요).
    """
    userErrors: [UserError!]!
    accessToken: String
    refreshToken: String
    tokenType: String
    "accessToken 남은 유효기간(초)."
    accessTokenExpiresIn: Int
    "refreshToken 남은 유효기간(초)."
    refreshTokenExpiresIn: Int
}

type LogoutPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}

input SuspendMemberInput {
    memberId: ID!
    reason: String!
    "정지 만료 시각(ISO-8601). 없으면 무기한."
    suspendedUntil: String
}

input ReactivateMemberInput {
    memberId: ID!
}

type WithdrawMemberPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}

type AdminActionPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}

input AssignRoleInput {
    memberId: ID!
    roleCode: String!
}

input RevokeRoleInput {
    memberId: ID!
    roleCode: String!
}

"역할 부여/회수 결과. changed=false면 멱등(이미 부여됨/원래 없음)."
type RoleChangePayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    changed: Boolean
}

"본인 정보(me). 이메일은 본인이므로 평문 노출. roles/permissions로 클라이언트 메뉴를 렌더한다."
type Me {
    id: ID!
    email: String!
    nickname: String!
    profileImageUrl: String
    status: MemberStatus!
    emailVerified: Boolean!
    "이메일 변경(changeEmail) 가능 여부. Provider.EMAIL 회원만 참이다. 거짓이면 설정 화면에 변경 진입점을 노출하지 않는다."
    canChangeEmail: Boolean!
    roles: [String!]!
    permissions: [String!]!
    "가입일(ISO-8601)."
    createdAt: String!
}

"관리자 회원 단건 상세. member:read 권한 필요."
type MemberDetail {
    id: ID!
    email: String!
    nickname: String!
    profileImageUrl: String
    status: MemberStatus!
    emailVerified: Boolean!
    "정지 정보(정지 상태에서만 채워짐, ISO-8601)."
    suspendedAt: String
    suspendedUntil: String
    suspensionReason: String
    roles: [String!]!
    createdAt: String!
}

"관리자 회원 목록 항목. 최소수집: 이메일 미포함."
type MemberSummary {
    id: ID!
    nickname: String!
    status: MemberStatus!
    roles: [String!]!
    createdAt: String!
}

"커서 페이지네이션 공통 페이지 정보(Relay Connection)."
type PageInfo {
    hasNextPage: Boolean!
    hasPreviousPage: Boolean!
    startCursor: String
    endCursor: String
}

"회원 목록 커서 연결(Relay Connection)."
type MemberConnection {
    edges: [MemberEdge!]!
    pageInfo: PageInfo!
    "전체 개수(선택)."
    totalCount: Int
}

type MemberEdge {
    cursor: String!
    node: MemberSummary!
}
