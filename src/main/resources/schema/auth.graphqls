type Query {
    "GraphQL 스키마 헬스 체크(루트 Query 필요)."
    authHealth: String!
    "본인 정보. accessToken 인증만 필요(권한 불요). 역할/유효권한을 담아 클라이언트 메뉴 렌더에 사용한다."
    me: Me!
    "관리자 회원 단건 조회. member:read 권한 필요."
    member(id: ID!): MemberDetail!
    "관리자 회원 목록(커서 페이지네이션). member:read 권한 필요. 목록은 이메일을 포함하지 않는다(최소수집)."
    members(status: MemberStatus, roleCode: String, first: Int = 20, after: String): MemberConnection!
    "할당 가능한 역할 목록. role:assign 권한이 필요하다."
    assignableRoles: [RoleInfo!]!
    "호출자의 약관별 동의 상태. 필수·선택을 모두 포함한다. required가 참이면서 agreed가 거짓인 항목이 있으면 클라이언트가 이용 게이트를 건다."
    agreements: [AgreementStatus!]!
}

type Mutation {
    "SNS 회원가입. 가입은 이메일 검증 완료를 기다리지 않고 성공 처리된다."
    registerSnsMember(input: RegisterSnsMemberInput!): RegisterSnsMemberPayload!
    "자체(이메일) 회원가입. 이메일+비밀번호로 가입하고 이메일 인증으로 활성화한다."
    registerEmailMember(input: RegisterEmailMemberInput!): RegisterEmailMemberPayload!
    "이메일 검증 코드 확인."
    verifyEmail(input: VerifyEmailInput!): VerifyEmailPayload!
    "이메일 검증 코드 재발송."
    resendVerification(input: ResendVerificationInput!): ResendVerificationPayload!
    "SNS 로그인. 기존 회원만 인증하며 accessToken/refreshToken을 발급한다."
    loginSns(input: LoginSnsInput!): AuthTokenPayload!
    "자체(이메일) 로그인. 비밀번호 검증 + 이메일 인증 완료를 요구하며 토큰을 발급한다."
    loginEmail(input: LoginEmailInput!): AuthTokenPayload!
    "비밀번호 재설정 요청. 이메일로 재설정 코드를 발송한다(계정 유무는 응답으로 드러내지 않음)."
    requestPasswordReset(input: RequestPasswordResetInput!): RequestPasswordResetPayload!
    "비밀번호 재설정 실행. 이메일+코드 검증 성공 시 새 비밀번호로 교체하고 기존 세션을 폐기한다."
    resetPassword(input: ResetPasswordInput!): ResetPasswordPayload!
    "refreshToken으로 accessToken 재발급(refresh 회전)."
    refreshToken(input: RefreshTokenInput!): AuthTokenPayload!
    "로그아웃. 제출한 refreshToken을 폐기한다."
    logout(input: LogoutInput!): LogoutPayload!
    "회원 탈퇴(본인). accessToken 인증 필요. 회원과 소유 데이터가 삭제된다."
    withdrawMember: WithdrawMemberPayload!
    "회원 정지(관리자). member:suspend 권한 필요."
    suspendMember(input: SuspendMemberInput!): AdminActionPayload!
    "회원 정지 해제(관리자). member:reactivate 권한 필요."
    reactivateMember(input: ReactivateMemberInput!): AdminActionPayload!
    "역할 부여(관리자). role:assign 권한 필요."
    assignRole(input: AssignRoleInput!): RoleChangePayload!
    "역할 회수(관리자). role:revoke 권한 필요. 본인의 마지막 관리 역할 회수는 거부된다."
    revokeRole(input: RevokeRoleInput!): RoleChangePayload!
    "닉네임 변경. 회원 간 고유해야 하며 중복 시 실패한다."
    changeNickname(input: ChangeNicknameInput!): ChangeNicknamePayload!
    "프로필 이미지 업로드용 presigned PUT URL 발급. profile 네임스페이스의 단일 오브젝트 키를 쓴다(게시물 이미지 키와 분리된다). 실제 업로드는 클라이언트가 오브젝트 스토리지로 직접 PUT하며 GraphQL을 거치지 않는다."
    createProfileImageUploadUrl(input: CreateProfileImageUploadUrlInput!): CreateProfileImageUploadUrlPayload!
    "프로필 이미지 업로드 완료 확인. 서버가 실제 크기와 매직바이트를 검증하고 통과하면 확정 위치로 옮겨 회원에 반영한다."
    confirmProfileImageUpload(input: ConfirmProfileImageUploadInput!): ConfirmProfileImageUploadPayload!
    "프로필 이미지 제거. 멱등 — 이미 없어도 성공한다."
    removeProfileImage: RemoveProfileImagePayload!
    "약관 동의를 개별로 켜고 끈다. 필수 약관도 철회할 수 있으며, 철회하면 required가 참이면서 agreed가 거짓인 상태가 되어 클라이언트가 이용 게이트를 건다. 서버는 철회한 회원의 다른 오퍼레이션을 거절하지 않는다."
    updateAgreement(input: UpdateAgreementInput!): UpdateAgreementPayload!
    "미동의 상태인 필수 약관에 동의한다. 동의만 받으며 철회는 받지 않는다 — 필수 약관 철회는 사실상 서비스 이용 중단이므로 탈퇴로만 가능하다. 모든 필수 약관이 동의되면 이용 게이트가 해제된다."
    agreeToRequiredTerms(input: AgreeToRequiredTermsInput!): AgreeToRequiredTermsPayload!
}

"약관 1건에 대한 호출자의 동의 상태."
type AgreementStatus {
    termsCode: TermsCode!
    "필수 약관 여부. 참이면 미동의 시 이용 게이트 대상이다."
    required: Boolean!
    "현재 시행 중인 버전에 대한 동의 여부. 새 버전이 시행되면 이전 버전의 동의는 이월되지 않으므로 거짓이 된다."
    agreed: Boolean!
    "현재 시행 중인 버전에 동의한 시각(ISO-8601). 미동의 상태면 null이다."
    agreedAt: String
    "현재 시행 중인 약관 문서 버전."
    version: String!
}

input ChangeNicknameInput {
    "앞뒤 공백은 제거되어 저장된다. 2자 이상 20자 이하."
    nickname: String!
}

type ChangeNicknamePayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    "성공 시 반영된 닉네임."
    nickname: String
}

input CreateProfileImageUploadUrlInput {
    "image/jpeg · image/png · image/webp만 허용된다. 서명에 포함되므로 업로드 요청의 Content-Type과 정확히 일치해야 한다."
    contentType: String!
    "선언한 바이트 크기. 상한 10485760(10MiB). 서명에 포함되므로 Content-Length와 정확히 일치해야 한다."
    contentLength: Int!
}

type CreateProfileImageUploadUrlPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    "presigned PUT URL. 단일 오브젝트 키 스코프. 실패 시 null."
    uploadUrl: String
    "업로드 후 confirmProfileImageUpload로 되돌려줄 임시 오브젝트 키. profile 네임스페이스."
    objectKey: String
    "발급 시각 + 30분(ISO-8601)."
    expiresAt: String
}

input ConfirmProfileImageUploadInput {
    "createProfileImageUploadUrl이 반환한 임시 키."
    objectKey: String!
}

type ConfirmProfileImageUploadPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    "반영된 최종 오브젝트 키. 서버는 이미지 바이트를 중계하지 않으며 클라이언트가 CDN 베이스 URL과 조합해 사용한다."
    profileImageKey: String
}

type RemoveProfileImagePayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}

input UpdateAgreementInput {
    "시행 중인 약관이어야 한다. 필수·선택을 가리지 않는다."
    termsCode: TermsCode!
    agreed: Boolean!
}

type UpdateAgreementPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    "반영 후의 상태."
    agreement: AgreementStatus
}

input AgreeToRequiredTermsInput {
    "동의할 필수 약관 코드. 미동의 상태인 필수 약관을 한 번에 넘긴다. 선택 약관 코드를 넣으면 실패한다."
    termsCodes: [TermsCode!]!
}

type AgreeToRequiredTermsPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    "반영 후 전체 약관 상태. 클라이언트가 게이트 해제 여부를 이 값으로 재계산한다."
    agreements: [AgreementStatus!]!
}

"모든 mutation 응답이 구현하는 공통 규약. success와 도메인 검증 실패(userErrors)를 담는다."
interface BaseResponse {
    "유스케이스가 성공했는지. 실패 시 userErrors가 채워진다."
    success: Boolean!
    "예상 가능한 도메인/입력 검증 실패 목록. 시스템/인증 오류는 최상위 errors로 전달된다."
    userErrors: [UserError!]!
}

"사용자에게 보여줄 수 있는 도메인/입력 검증 오류."
type UserError {
    "머신 판독용 코드(예: MEMBER_ALREADY_REGISTERED, INVALID_INPUT)."
    code: String!
    "사용자 노출 메시지."
    message: String!
    "관련 입력 필드 경로(있을 때). 예: input.email"
    field: String
}

"회원 상태. 탈퇴는 행 삭제(hard delete)이므로 상태값에 없다."
enum MemberStatus {
    ACTIVE
    SUSPENDED
}

enum Provider {
    APPLE
    GOOGLE
    KAKAO
}

"약관 코드. 클라이언트가 동의 항목을 하드코딩 없이 렌더한다."
enum TermsCode {
    SERVICE
    PRIVACY
    LOCATION
    MARKETING
}

"할당 가능한 역할. code는 assignRole·revokeRole의 roleCode로 쓰는 값이다."
type RoleInfo {
    code: String!
    name: String!
    description: String
}

input RegisterSnsMemberInput {
    provider: Provider!
    "SNS id_token(또는 dev 토큰)."
    idToken: String!
    "폼 제출 이메일(필수). provider 값이 기본 채워지되 수정 가능."
    email: String!
    "만 14세 이상 확인."
    ageVerified: Boolean!
    agreements: [AgreementInput!]!
}

input AgreementInput {
    termsCode: TermsCode!
    agreed: Boolean!
}

input RegisterEmailMemberInput {
    email: String!
    "비밀번호. 영문·숫자·특수문자 3종 모두 포함, 8자 이상."
    password: String!
    "만 14세 이상 확인."
    ageVerified: Boolean!
    agreements: [AgreementInput!]!
}

input LoginEmailInput {
    email: String!
    password: String!
}

input RequestPasswordResetInput {
    email: String!
}

input ResetPasswordInput {
    email: String!
    "이메일로 받은 6자리 재설정 코드."
    code: String!
    "새 비밀번호. 영문·숫자·특수문자 3종 모두 포함, 8자 이상."
    newPassword: String!
}

input VerifyEmailInput {
    "가입 응답으로 받은 검증 핸들(email_verification.public_id)."
    verificationId: String!
    code: String!
}

input ResendVerificationInput {
    verificationId: String!
}

type RegisterSnsMemberPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    "성공 시 채워짐. 이메일 검증 완료 여부."
    emailVerified: Boolean
    "미검증인 경우에만 채워지는 검증 핸들."
    verificationId: String
}

type RegisterEmailMemberPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    "이메일 인증 코드 검증에 사용할 핸들(가입 성공 시 채워짐)."
    verificationId: String
}

type RequestPasswordResetPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}

type ResetPasswordPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    "실패 사유(EXPIRED/CONSUMED/MAX_ATTEMPTS_EXCEEDED/CODE_MISMATCH/INVALID_OR_EXPIRED). 성공 시 null."
    failureReason: String
}

type VerifyEmailPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    "코드 검증 결과(성공 시 채워짐)."
    verified: Boolean
    "실패 사유(EXPIRED/CONSUMED/MAX_ATTEMPTS_EXCEEDED/CODE_MISMATCH). 성공 시 null."
    failureReason: String
}

type ResendVerificationPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    verificationId: String
    expiresAt: String
}

input LoginSnsInput {
    provider: Provider!
    "SNS id_token(또는 dev 토큰)."
    idToken: String!
}

input RefreshTokenInput {
    refreshToken: String!
}

input LogoutInput {
    refreshToken: String!
}

type AuthTokenPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    accessToken: String
    refreshToken: String
    tokenType: String
    "accessToken 남은 유효기간(초)."
    accessTokenExpiresIn: Int
    "refreshToken 남은 유효기간(초)."
    refreshTokenExpiresIn: Int
}

type LogoutPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}

input SuspendMemberInput {
    memberId: ID!
    reason: String!
    "정지 만료 시각(ISO-8601). 없으면 무기한."
    suspendedUntil: String
}

input ReactivateMemberInput {
    memberId: ID!
}

type WithdrawMemberPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}

type AdminActionPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}

input AssignRoleInput {
    memberId: ID!
    roleCode: String!
}

input RevokeRoleInput {
    memberId: ID!
    roleCode: String!
}

"역할 부여/회수 결과. changed=false면 멱등(이미 부여됨/원래 없음)."
type RoleChangePayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
    changed: Boolean
}

"본인 정보(me). 이메일은 본인이므로 평문 노출. roles/permissions로 클라이언트 메뉴를 렌더한다."
type Me {
    id: ID!
    email: String!
    nickname: String!
    profileImageUrl: String
    status: MemberStatus!
    emailVerified: Boolean!
    roles: [String!]!
    permissions: [String!]!
    "가입일(ISO-8601)."
    createdAt: String!
}

"관리자 회원 단건 상세. member:read 권한 필요."
type MemberDetail {
    id: ID!
    email: String!
    nickname: String!
    profileImageUrl: String
    status: MemberStatus!
    emailVerified: Boolean!
    "정지 정보(정지 상태에서만 채워짐, ISO-8601)."
    suspendedAt: String
    suspendedUntil: String
    suspensionReason: String
    roles: [String!]!
    createdAt: String!
}

"관리자 회원 목록 항목. 최소수집: 이메일 미포함."
type MemberSummary {
    id: ID!
    nickname: String!
    status: MemberStatus!
    roles: [String!]!
    createdAt: String!
}

"커서 페이지네이션 공통 페이지 정보(Relay Connection)."
type PageInfo {
    hasNextPage: Boolean!
    hasPreviousPage: Boolean!
    startCursor: String
    endCursor: String
}

"회원 목록 커서 연결(Relay Connection)."
type MemberConnection {
    edges: [MemberEdge!]!
    pageInfo: PageInfo!
    "전체 개수(선택)."
    totalCount: Int
}

type MemberEdge {
    cursor: String!
    node: MemberSummary!
}
