extend type Query {
    "내가 참여한 대화 목록. 최근 활동순. 기본 20, 상한 50이며 초과분은 절삭된다."
    conversations(first: Int = 20, after: String): ConversationConnection!

    """
    대화의 메시지. 최신순으로 페이징한다 — 채팅 화면은 위로 올릴수록 과거를 더 불러온다.
    기본 30, 상한 50이며 초과분은 절삭된다.
    참여자가 아니거나 없는 대화면 최상위 errors[]의 FORBIDDEN이다 — 조회는 볼 자격 자체가 없어
    부분 성공이 성립하지 않는다.
    """
    conversationMessages(conversationId: ID!, first: Int = 30, after: String): MessageConnection!
}

extend type Mutation {
    """
    상대 회원을 지정해 1:1 대화를 시작한다.
    같은 상대와 대화가 이미 있으면 새로 만들지 않고 기존 대화를 반환한다.
    첫 메시지 전송은 별개 호출이라 빈 대화가 존재할 수 있다.

    실패는 MEMBER_NOT_FOUND(없거나 탈퇴한 회원)·BLOCKED(양방향 차단)·
    SELF_CONVERSATION(자기 자신 지목)이며 userErrors로 반환된다.
    """
    startConversation(input: StartConversationInput!): StartConversationPayload!

    """
    메시지 전송. 텍스트와 사진을 함께 또는 각각 보낼 수 있으며 둘 다 비면 거부된다.
    대화 성립 이후에 생긴 차단도 여기서 다시 판정되어 거부된다.
    """
    sendMessage(input: SendMessageInput!): SendMessagePayload!

    """
    타이핑 상태 알림. 영속화하지 않으며 전달 보장이 없다.
    상대가 구독 중이 아니어도 아무 효과 없이 성공한다 — 받을 사람이 없는 것은 실패가 아니다.
    실패해도 재시도하지 않는 것이 정상이다.
    """
    notifyTyping(input: NotifyTypingInput!): NotifyTypingPayload!

    """
    대화를 읽은 것으로 표시한다. **호출 시점은 클라이언트가 정한다** —
    채팅방 진입·스크롤 하단 도달·포그라운드 복귀 등 어디서 부를지는 UX 판단이며,
    메시지를 조회하는 것만으로는 읽음 처리되지 않는다.

    같은 요청을 여러 번 보내도 안전하다 — 읽음 지점은 뒤로 가지 않는다.
    """
    markConversationRead(input: MarkConversationReadInput!): MarkConversationReadPayload!

    """
    DM 메시지 신고. 여러 건을 한 신고로 함께 접수한다.
    한 신고는 한 대화에 대한 것이며, 여러 대화의 메시지를 섞으면 거부된다.
    운영자는 여기에 포함된 메시지만 열람하며 대화 전체를 열지 않는다.
    누적 신고에 의한 자동 숨김은 적용되지 않는다 — 기록만 되고 조치는 사람이 판단한다.
    """
    reportMessages(input: ReportMessagesInput!): ReportMessagesPayload!
}

"""
실시간 구독. 인증은 연결 수립(connection_init) 시 1회 수행하고, 구독별 권한 검사는
subscribe 시점에 다시 한다.
"""
type Subscription {
    """
    상대의 타이핑 상태. 대화 참여자만 구독할 수 있으며, 아니면 구독 시작 시점에 FORBIDDEN이다.

    전달 보장이 없다 — 연결이 끊긴 동안의 이벤트는 유실되며 재연결해도 재전송되지 않는다.
    클라이언트는 후속 이벤트가 끊기면 표시를 자동으로 해제해야 한다.
    """
    typingIndicator(conversationId: ID!): TypingEvent!

    """
    대화에 도착한 새 메시지. 대화 참여자만 구독할 수 있으며, 아니면 구독 시작 시점에
    FORBIDDEN이다.

    **이 구독은 "새 메시지가 있다"는 신호이지 전달 보장 수단이 아니다.** 연결이 끊긴 동안의
    메시지는 이 스트림으로 오지 않으므로, 재연결 시 conversationMessages로 빈 구간을 메워야
    한다 — 서버의 원본은 언제나 DB다.

    본인이 보낸 메시지도 전달된다(다른 기기에서 보낸 경우가 있다). ownedByViewer로 구분한다.
    """
    newMessage(conversationId: ID!): Message!
}

"1:1 대화. 그룹 대화는 다루지 않는다."
type Conversation {
    id: ID!

    "상대방. 1:1이므로 단일 필드로 충분하다."
    counterpart: PostAuthor!

    "가장 최근 메시지. 대화 시작과 첫 전송이 별개 호출이라 빈 대화가 존재할 수 있어 nullable이다."
    lastMessage: Message

    """
    호출자 기준 읽지 않은 메시지 수. 내가 보낸 메시지는 세지 않는다.
    `markConversationRead`를 호출하기 전까지 줄어들지 않는다.
    """
    unreadCount: Int!

    "정렬 기준. 최근 메시지 시각이며, 메시지가 없으면 대화 생성 시각이다. ISO-8601."
    updatedAt: String!
}

"정렬은 updatedAt 내림차순이다."
type ConversationConnection {
    edges: [ConversationEdge!]!
    pageInfo: PageInfo!
}

type ConversationEdge {
    cursor: String!
    node: Conversation!
}

type Message {
    id: ID!

    """
    0~1000자. 서버에 암호화되어 저장되며 조회 시 복원된다.
    **사진만 보낸 메시지는 빈 문자열이다.**

    본문도 사진도 없는 메시지가 존재한다 — 피드 인용만 있던 과거 메시지이며 삭제하지 않고
    남긴다. 클라이언트는 이 경우를 빈 말풍선이 아니라 내용 없음으로 표시해야 한다.
    """
    body: String!

    """
    첨부 사진의 오브젝트 키. confirmPostImageUploads가 확정한 키다.
    서버는 이미지 바이트를 중계하지 않으며, 클라이언트가 CDN 베이스 URL과 조합해 쓴다.
    """
    photoKey: String

    sender: PostAuthor!

    "호출자가 보낸 메시지인지. 클라이언트의 말풍선 정렬을 결정한다."
    ownedByViewer: Boolean!

    "ISO-8601. 정렬 기준이다."
    createdAt: String!
}

"정렬은 createdAt 내림차순이다 — 채팅 화면은 위로 올릴수록 과거를 더 불러온다."
type MessageConnection {
    edges: [MessageEdge!]!
    pageInfo: PageInfo!
}

type MessageEdge {
    cursor: String!
    node: Message!
}

input StartConversationInput {
    "대화 상대의 회원 id. PostAuthor.id와 같은 식별자다."
    counterpartMemberId: ID!
}

type StartConversationPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!

    "생성되었거나 기존에 있던 대화의 id."
    conversationId: ID
}

input SendMessageInput {
    conversationId: ID!

    """
    0~1000자. 앞뒤 공백은 제거된 뒤 판정하며, 상한을 넘으면 잘리지 않고 거부된다.
    **사진이 있으면 빈 문자열이어도 된다.** body와 photoKey가 모두 비면 거부된다.
    """
    body: String!

    "첨부할 사진. confirmPostImageUploads가 반환한 확정 키를 그대로 쓴다."
    photoKey: String
}

type SendMessagePayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!

    "생성된 메시지의 id. 성공 시에만 채워진다."
    messageId: ID
}

input NotifyTypingInput {
    conversationId: ID!
}

type NotifyTypingPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}

input MarkConversationReadInput {
    conversationId: ID!

    """
    여기까지 읽은 것으로 표시한다. **생략하면 그 대화의 마지막 메시지까지**로 본다 —
    "모두 읽음"을 표현하는 방법이며, 마지막 메시지 id를 몰라도 부를 수 있다.
    """
    upToMessageId: ID
}

type MarkConversationReadPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!

    "처리 후 남은 안 읽은 메시지 수. 클라이언트가 뱃지를 다시 조회하지 않아도 되도록 돌려준다."
    unreadCount: Int!
}

input ReportMessagesInput {
    "신고 대상 메시지. 1건 이상이며 모두 같은 대화에 속해야 한다. 자기 메시지는 담을 수 없다."
    messageIds: [ID!]!

    reason: ReportReason!

    "자유 서술. reason이 OTHER이면 필수 — 기존 reportContent와 같은 규약이다."
    detail: String
}

type ReportMessagesPayload implements BaseResponse {
    success: Boolean!
    userErrors: [UserError!]!
}

"""
타이핑 이벤트. 영속화되지 않으므로 이후 쿼리로 다시 조회할 방법이 없다 —
전달 시점의 스냅샷이다.
"""
type TypingEvent {
    "타이핑 중인 상대방."
    sender: PostAuthor!

    """
    발생 시각(ISO-8601). 클라이언트가 일정 시간 후 표시를 자동으로 내리는 판단에 쓴다.
    이벤트가 유실돼 화면이 "입력 중"에 갇히는 것을 막기 위한 값이다.
    """
    emittedAt: String!
}
